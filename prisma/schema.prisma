generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  A2
  B1
  B2
  C1
}

enum ArticleStatus {
  FETCHED
  PROCESSING
  DRAFT
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ExpressionType {
  IDIOM
  PHRASAL_VERB
  COLLOCATION
  COMMON_EXPRESSION
  SLANG
  NEWS_ENGLISH
}

/// A material change an admin makes to an article (M5).
enum ModerationAction {
  PUBLISH
  ARCHIVE
  RESTORE
  CHANGE_CATEGORY
  CHANGE_DIFFICULTY
}

/// News is adapted from one source; an explainer is written from general
/// knowledge and lists its references (W).
enum ArticleKind {
  NEWS
  EXPLAINER
}

/// A licence a news source is published under, which its adaptation must credit.
enum SourceLicence {
  /// The Open Government Licence v3.0, which covers GOV.UK news (ADR-004).
  OGL_3_0
}

model Category {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String?
  displayOrder Int
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  articles     Article[]
  expressions  CategoryExpression[]

  @@index([isActive, displayOrder])
}

model Article {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  shortSummary       String?
  categoryId         String
  difficulty         Difficulty
  status             ArticleStatus       @default(DRAFT)
  kind               ArticleKind         @default(NEWS)
  /// News only: a CHECK constraint requires the source fields on news and
  /// forbids them on explainers.
  sourceName         String?
  sourceUrl          String?             @unique
  sourceLicence      SourceLicence?
  sourceImageUrl     String?
  imageAttribution   String?
  sourcePublishedAt  DateTime?
  /// The date readers see: the source's publication time for news, which a
  /// CHECK constraint enforces, and the day an explainer was written.
  datedAt            DateTime
  publishedOnSiteAt  DateTime?
  wordCount          Int
  readingTimeMinutes Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paragraphs         ArticleParagraph[]
  references         ArticleReference[]
  expressions        ArticleExpression[]
  vocabulary         ArticleVocabulary[]
  moderationEvents   ModerationEvent[]

  @@index([categoryId, status, datedAt])
  @@index([status, publishedOnSiteAt])
  @@index([difficulty, status])
}

model ArticleParagraph {
  id          String              @id @default(cuid())
  articleId   String
  order       Int
  english     String
  turkish     String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  article     Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  expressions ArticleExpression[]

  @@unique([articleId, order])
  // Lets an expression occurrence reference its paragraph and article together.
  @@unique([id, articleId])
}

/// A source an explainer's facts can be checked in (W).
model ArticleReference {
  id        String   @id @default(cuid())
  articleId String
  order     Int
  title     String
  publisher String
  url       String
  /// The day the reference was last read and found to support the explainer.
  checkedAt DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, order])
}

/// A contextual word lookup, cached per word, sentence and provider/schema version.
model VocabularyEntry {
  id                String              @id @default(cuid())
  surfaceWord       String
  normalizedWord    String
  lemma             String?
  partOfSpeech      String?
  englishDefinition String
  turkishMeaning    String
  exampleSentence   String?
  ipa               String?
  contextSentence   String
  /// SHA-256 of the normalized context sentence.
  contextHash       String
  provider          String
  providerVersion   String
  schemaVersion     Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  articles          ArticleVocabulary[]

  @@unique([normalizedWord, contextHash, provider, providerVersion, schemaVersion])
}

/// Curated key vocabulary for an article, distinct from on-demand lookups.
model ArticleVocabulary {
  id                String          @id @default(cuid())
  articleId         String
  vocabularyEntryId String
  sourceSentence    String
  displayOrder      Int
  source            String?
  createdAt         DateTime        @default(now())
  article           Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  vocabularyEntry   VocabularyEntry @relation(fields: [vocabularyEntryId], references: [id], onDelete: Restrict)

  @@unique([articleId, vocabularyEntryId])
  @@unique([articleId, displayOrder])
}

/// A reusable Real English expression. It may belong to several categories.
model Expression {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  expression           String
  normalizedExpression String
  type                 ExpressionType
  difficulty           Difficulty?
  englishMeaning       String
  turkishMeaning       String
  exampleEnglish       String?
  exampleTurkish       String?
  usageNote            String?
  literalWarning       String?
  pronunciation        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  categories           CategoryExpression[]
  occurrences          ArticleExpression[]

  @@index([normalizedExpression])
}

model CategoryExpression {
  categoryId   String
  expressionId String
  displayOrder Int
  isFeatured   Boolean    @default(false)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  @@id([categoryId, expressionId])
  @@index([categoryId, displayOrder])
}

/// One occurrence of an expression in an article's English text.
model ArticleExpression {
  id           String           @id @default(cuid())
  articleId    String
  expressionId String
  paragraphId  String
  surfaceText  String
  sentence     String
  /// UTF-16 offsets into the paragraph's English text.
  startOffset  Int
  endOffset    Int
  displayOrder Int
  source       String?
  confidence   Float?
  createdAt    DateTime         @default(now())
  article      Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  expression   Expression       @relation(fields: [expressionId], references: [id], onDelete: Restrict)
  // The composite key guarantees that the paragraph belongs to the same article.
  paragraph    ArticleParagraph @relation(fields: [paragraphId, articleId], references: [id, articleId], onDelete: Cascade)

  @@unique([paragraphId, startOffset, expressionId])
  @@index([articleId, displayOrder])
  @@index([expressionId])
}

// Admin sign-in (ADR-003). Better Auth reads and writes these five models
// through its Prisma adapter and generates their IDs itself. They hold admins
// only: readers have no accounts.

/// An admin who can sign in. Created on the server, never by public sign-up.
model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  twoFactorEnabled Boolean?          @default(false)
  /// `admin`, set only by the admin command. Empty for any other account,
  /// which can open no admin page.
  role             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  moderationEvents ModerationEvent[]
}

/// A signed-in session. Deleting the row revokes it.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way to sign in. An email-and-password login is the `credential` provider,
/// with a hashed password.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived value Better Auth checks later, such as a verification token.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

/// An admin's authenticator-app secret and backup codes, stored encrypted.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

/// One admin action on an article, written in the same transaction as the
/// change itself. Rows are never edited or deleted, and neither the article
/// nor the admin can be deleted while a row names them.
model ModerationEvent {
  id        String           @id @default(cuid())
  articleId String
  actorId   String
  action    ModerationAction
  /// Why the admin did it. Required for every action except publishing.
  reason    String?
  /// The changed fields before and after, such as `{ "status": "DRAFT" }`.
  before    Json
  after     Json
  createdAt DateTime         @default(now())
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([actorId])
}
