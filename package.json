{
  "name": "newslingo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.7.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
