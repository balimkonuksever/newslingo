{
  "name": "newslingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "tsx scripts/with-test-database.ts vitest run --project integration",
    "test:e2e": "tsx scripts/with-test-database.ts playwright test",
    "test:e2e:ui": "tsx scripts/with-test-database.ts playwright test --ui",
    "postinstall": "prisma generate --no-hints",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "tsx scripts/with-test-database.ts prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:reference": "tsx prisma/seed.ts reference",
    "db:seed:demo": "tsx prisma/seed.ts demo",
    "db:reset:test": "tsx scripts/with-test-database.ts tsx scripts/reset-test-database.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx --conditions=react-server scripts/admin-account.ts create",
    "admin:reset": "tsx --conditions=react-server scripts/admin-account.ts reset",
    "articles:import": "tsx scripts/import-articles.ts",
    "site:build": "tsx scripts/build-site.ts",
    "site:serve": "tsx scripts/serve-site.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.12",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "16.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
