DATABASE_URL=postgresql://newslingo:newslingo_dev_only@127.0.0.1:5432/newslingo?schema=public
TEST_DATABASE_URL=postgresql://newslingo:newslingo_dev_only@127.0.0.1:5432/newslingo_test?schema=public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Word lookups use the editorial entries seeded with the articles. Words without
# one show "not in the dictionary yet" unless a provider is set: none (default),
# fixture, or anthropic. To use Claude, set DICTIONARY_PROVIDER=anthropic in
# .env.local and put your key there.
DICTIONARY_PROVIDER=none
DICTIONARY_MODEL=claude-opus-5
# The kill switch: serve cached entries and look up nothing new.
DICTIONARY_CACHE_ONLY=false
ANTHROPIC_API_KEY=
